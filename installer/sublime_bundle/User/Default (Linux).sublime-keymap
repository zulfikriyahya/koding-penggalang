[
  // === Command Palette & Quick Navigation (VS Code / GitHub Windows) ===
  { "keys": ["f1"], "command": "show_overlay", "args": {"overlay": "command_palette"} },
  { "keys": ["ctrl+shift+p"], "command": "show_overlay", "args": {"overlay": "command_palette"} },
  { "keys": ["ctrl+p"], "command": "show_overlay", "args": {"overlay": "goto", "show_files": true} },
  { "keys": ["ctrl+shift+o"], "command": "show_overlay", "args": {"overlay": "goto", "text": "@"} },
  { "keys": ["ctrl+t"], "command": "show_overlay", "args": {"overlay": "goto", "text": "#"} },
  { "keys": ["ctrl+g"], "command": "show_overlay", "args": {"overlay": "goto", "text": ":"} },
  { "keys": ["f12"], "command": "goto_definition" },
  { "keys": ["shift+f12"], "command": "goto_reference" },
  { "keys": ["alt+left"], "command": "jump_back" },
  { "keys": ["alt+right"], "command": "jump_forward" },

  // === Sidebar, Layout, Tabs & Zen Mode (VS Code Windows) ===
  { "keys": ["ctrl+b"], "command": "toggle_side_bar" },
  { "keys": ["ctrl+shift+b"], "command": "build" },
  { "keys": ["ctrl+,"], "command": "edit_settings", "args": {"base_file": "${packages}/Default/Preferences.sublime-settings", "default": "{\n\t$0\n}\n"} },
  { "keys": ["ctrl+k", "z"], "command": "toggle_distraction_free" },
  { "keys": ["ctrl+\\"], "command": "set_layout", "args": {"cols": [0.0, 0.5, 1.0], "rows": [0.0, 1.0], "cells": [[0, 0, 1, 1], [1, 0, 2, 1]]} },
  { "keys": ["ctrl+k", "ctrl+\\"], "command": "set_layout", "args": {"cols": [0.0, 1.0], "rows": [0.0, 1.0], "cells": [[0, 0, 1, 1]]} },
  { "keys": ["ctrl+1"], "command": "focus_group", "args": {"group": 0} },
  { "keys": ["ctrl+2"], "command": "focus_group", "args": {"group": 1} },
  { "keys": ["ctrl+3"], "command": "focus_group", "args": {"group": 2} },
  { "keys": ["ctrl+tab"], "command": "next_view" },
  { "keys": ["ctrl+shift+tab"], "command": "prev_view" },
  { "keys": ["ctrl+w"], "command": "close" },
  { "keys": ["ctrl+shift+t"], "command": "reopen_last_file" },
  { "keys": ["ctrl+k", "s"], "command": "save_all" },

  // === Line & Multi-Cursor Editing (VS Code Windows) ===
  { "keys": ["alt+up"], "command": "swap_line_up" },
  { "keys": ["alt+down"], "command": "swap_line_down" },
  { "keys": ["shift+alt+up"], "command": "duplicate_line" },
  { "keys": ["shift+alt+down"], "command": "duplicate_line" },
  { "keys": ["ctrl+shift+k"], "command": "run_macro_file", "args": {"file": "res://Packages/Default/Delete Line.sublime-macro"} },
  { "keys": ["ctrl+enter"], "command": "run_macro_file", "args": {"file": "res://Packages/Default/Add Line.sublime-macro"} },
  { "keys": ["ctrl+shift+enter"], "command": "run_macro_file", "args": {"file": "res://Packages/Default/Add Line Before.sublime-macro"} },
  { "keys": ["ctrl+d"], "command": "find_under_expand" },
  { "keys": ["ctrl+shift+l"], "command": "find_all_under" },
  { "keys": ["f2"], "command": "find_all_under" },
  { "keys": ["ctrl+alt+up"], "command": "select_lines", "args": {"forward": false} },
  { "keys": ["ctrl+alt+down"], "command": "select_lines", "args": {"forward": true} },
  { "keys": ["ctrl+/"], "command": "toggle_comment", "args": {"block": false} },
  { "keys": ["shift+alt+a"], "command": "toggle_comment", "args": {"block": true} },
  { "keys": ["ctrl+]"], "command": "indent" },
  { "keys": ["ctrl+["], "command": "unindent" },
  { "keys": ["alt+z"], "command": "toggle_setting", "args": {"setting": "word_wrap"} },
  { "keys": ["shift+alt+f"], "command": "reindent", "args": {"single_line": false}, "context": [{"key": "selector", "operator": "not_equal", "operand": "source.python"}] },
  { "keys": ["shift+alt+f"], "command": "python_ruff_format", "context": [{"key": "selector", "operator": "equal", "operand": "source.python"}] },
  { "keys": ["ctrl+."], "command": "python_ruff_quick_fix", "context": [{"key": "selector", "operator": "equal", "operand": "source.python"}] },
  { "keys": ["f8"], "command": "python_ruff_next_error", "context": [{"key": "selector", "operator": "equal", "operand": "source.python"}] },
  { "keys": ["ctrl+alt+l"], "command": "python_ruff_toggle_inline" },
  { "keys": ["ctrl+shift+m"], "command": "python_ruff_show_problems" },
  { "keys": ["f5"], "command": "build" },
  { "keys": ["f6"], "command": "python_run_interactive", "context": [{"key": "selector", "operator": "equal", "operand": "source.python"}] },
  { "keys": ["ctrl+space"], "command": "auto_complete" },

  // === Find & Replace (VS Code Windows) ===
  { "keys": ["ctrl+f"], "command": "show_panel", "args": {"panel": "find", "reverse": false} },
  { "keys": ["ctrl+h"], "command": "show_panel", "args": {"panel": "replace", "reverse": false} },
  { "keys": ["ctrl+shift+f"], "command": "show_panel", "args": {"panel": "find_in_files"} }
]
